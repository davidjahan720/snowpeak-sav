# ─────────────────────────────────────────────────────────────────
# SNOWPEAK SAV — variables d'environnement
# Copie ce fichier en `.env` puis remplis les valeurs.
# ─────────────────────────────────────────────────────────────────

# Clé API Mistral (https://console.mistral.ai/api-keys/)
MISTRAL_API_KEY=...

# Source des tickets : URL Google Sheet public OU chemin local (.ods, .xlsx, .csv)
# Exemples :
#   SHEET_URL=https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXX/edit
#   SHEET_URL=C:\chemin\vers\tickets.ods
SHEET_URL=

# GID de l'onglet (Google Sheets seulement, visible dans l'URL : ...#gid=0)
SHEET_GID=0

# Modèle Mistral utilisé
MISTRAL_MODEL=mistral-large-latest
